#!/usr/bin/env python
"""
CMORisation worker script (worker {{ worker_id }})
Generated automatically by ACCESS-MOPPy batch processing.

This worker repeatedly claims the next pending task from the shared database
and processes it, until no more pending tasks remain.
"""

import glob
import os
import sys
from pathlib import Path

import dask.distributed as dd
import psutil

from access_moppy import ACCESS_ESM_CMORiser
from access_moppy.tracking import TaskTracker


def detect_optimal_dask_config():
    """Detect Dask configuration for single-node processes=False mode.

    All workers share one Python process, so memory_limit must reflect
    the full process budget. n_workers=1 ensures the single worker's
    limit equals the PBS allocation rather than a fractional share.
    """
    n_cpus = int(os.environ.get('PBS_NCPUS', psutil.cpu_count()))
    allocated_memory_gb = int(os.environ.get('PBS_MEM_GB', '16'))

    system_memory_gb = psutil.virtual_memory().total / (1024**3)
    effective_memory = min(allocated_memory_gb, system_memory_gb * 0.9)

    print(f"Detected: {n_cpus} CPUs, {allocated_memory_gb}GB allocated, {system_memory_gb:.1f}GB system")

    return {
        'n_workers': 1,
        'threads_per_worker': n_cpus,
        'memory_per_worker': f"{int(effective_memory * 0.9)}GB",
    }


def process_variable(variable, experiment_id, source_id, variant_label,
                     grid_label, activity_id, input_folder, output_folder,
                     drs_root, file_patterns):
    """Process a single variable. Raises on error."""
    pattern = file_patterns.get(variable)
    if not pattern:
        raise ValueError(f'No pattern found for variable {variable}')

    full_pattern = str(input_folder + pattern)
    input_files = glob.glob(full_pattern)
    if not input_files:
        raise ValueError(f'No files found for pattern {full_pattern}')

    print(f'Processing {variable} with {len(input_files)} files')

    cmoriser = ACCESS_ESM_CMORiser(
        input_paths=input_files,
        compound_name=variable,
        experiment_id=experiment_id,
        source_id=source_id,
        variant_label=variant_label,
        grid_label=grid_label,
        activity_id=activity_id,
        output_path=output_folder,
        drs_root=drs_root,
    )

    cmoriser.run()
    cmoriser.write()


def main():
    import dask
    dask.config.set({
        'distributed.worker.memory.target': 0.6,
        'distributed.worker.memory.spill': 0.7,
        'distributed.worker.memory.pause': 0.8,
    })

    dask_config = detect_optimal_dask_config()

    n_workers = dask_config['n_workers']
    threads_per_worker = dask_config['threads_per_worker']
    memory_per_worker = dask_config['memory_per_worker']

    print(f"Worker {{ worker_id }}: Dask config: {n_workers} workers, {threads_per_worker} threads, {memory_per_worker} per worker")

    client = dd.Client(
        processes=False,
        threads_per_worker=threads_per_worker,
        n_workers=n_workers,
        memory_limit=memory_per_worker,
        silence_logs=False
    )

    print(f'Worker {{ worker_id }}: Dask dashboard: {client.dashboard_link}')

    try:
        # Get shared environment values
        db_path = os.environ['CMOR_TRACKER_DB']
        db_url = os.environ.get('CMOR_DB_URL') or None
        experiment_id = os.environ['EXPERIMENT_ID']
        source_id = os.environ['SOURCE_ID']
        variant_label = os.environ['VARIANT_LABEL']
        grid_label = os.environ['GRID_LABEL']
        activity_id = os.environ['ACTIVITY_ID']
        input_folder = os.environ['INPUT_FOLDER']
        output_folder = os.environ['OUTPUT_FOLDER']
        drs_root = os.environ.get('DRS_ROOT') or None

        # File patterns embedded at job-script generation time
        file_patterns = {{ config.get('file_patterns', {}) | tojson }}

        # Initialise tracker (PostgreSQL if db_url is set, else SQLite)
        tracker_kwargs = {'db_url': db_url} if db_url else {'db_path': Path(db_path)}
        tracker = TaskTracker(**tracker_kwargs)

        tasks_processed = 0

        while True:
            variable = tracker.claim_next_task(experiment_id)
            if variable is None:
                print(f'Worker {{ worker_id }}: No more pending tasks. Processed {tasks_processed} variable(s).')
                break

            print(f'Worker {{ worker_id }}: Claimed task: {variable}')
            try:
                process_variable(
                    variable=variable,
                    experiment_id=experiment_id,
                    source_id=source_id,
                    variant_label=variant_label,
                    grid_label=grid_label,
                    activity_id=activity_id,
                    input_folder=input_folder,
                    output_folder=output_folder,
                    drs_root=drs_root,
                    file_patterns=file_patterns,
                )
                tracker.mark_done(variable, experiment_id)
                tasks_processed += 1
                print(f'Worker {{ worker_id }}: Completed: {variable}')
            except Exception as e:
                print(f'Worker {{ worker_id }}: Error processing {variable}: {e}', file=sys.stderr)
                try:
                    tracker.mark_failed(variable, experiment_id, str(e))
                except Exception:
                    pass
                # Continue processing remaining tasks even if one fails

    finally:
        if client.status != 'closed':
            client.close()


if __name__ == '__main__':
    main()
